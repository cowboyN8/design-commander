{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR Pattern Detective per-ticket context",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["findings", "approved_decisions", "updated_at"],
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["id", "engine", "severity", "title", "description", "confidence", "traceability"],
              "properties": {
                "id": { "type": "string" },
                "engine": { "enum": ["ux_pattern", "accessibility", "convention"] },
                "severity": { "enum": ["blocker", "advisory"] },
                "title": { "type": "string" },
                "location": {
                  "type": "object",
                  "properties": {
                    "file": { "type": "string" },
                    "lines": { "type": "array", "items": { "type": "integer" } }
                  }
                },
                "description": { "type": "string" },
                "suggested_fix": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "traceability": { "enum": ["baseline", "extension", "exception", "none"] },
                "low_confidence": { "type": "boolean" },
                "override": {
                  "type": ["object", "null"],
                  "required": ["reasons", "by", "at"],
                  "properties": {
                    "reasons": { "type": "string" },
                    "by": { "type": "string" },
                    "at": { "type": "string" }
                  }
                }
              }
            }
          ]
        }
      },
      "approved_decisions": { "type": "array", "items": { "type": "string" } },
      "updated_at": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": false
  }
}
